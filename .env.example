# Copy to .env. docker compose reads this file automatically.

# --- Database ---
# Agents in docker compose connect to the 'postgres' service; host tools use 127.0.0.1.
DB_HOST=postgres
DB_PORT=5432
DB_USER=pia
DB_PASSWORD=change-me
DB_NAME=pia

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
# Model for chat / Telegram reasoning
LLM_MODEL=openai/gpt-4o-mini
# Optional comma-separated pool for extraction (defaults to free-tier models if empty)
LLM_MODEL_POOL=
# Must be the same model everywhere embeddings are written or queried
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- API bridge ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PIA_API_TOKEN=
FRONTEND_ORIGINS=http://localhost:5173

# --- Sensors ---
# Aviation/maritime agents have no real feed; they only emit demo data when true.
SIMULATED_SENSORS=false

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# --- Safety ---
# Set to production to make destructive scripts refuse to run.
PIA_ENV=development

# --- Cameras / live sessions ---
# Subset of camera providers (empty = all): hk_td,tfl,sg_lta,nzta,fi_digitraffic,toronto,nyc_dot,caltrans
CAMERA_PROVIDERS=
CAMERA_LIST_REFRESH_MIN=60
# US relay for NYC / Caltrans (see pia-api/relay/README.md). Leave empty to disable ON_DEMAND sources.
RELAY_URL=
RELAY_TOKEN=
RELAY_START_CMD=
RELAY_STOP_CMD=
LIVE_IDLE_MINUTES=15
LIVE_COST_PER_HOUR_USD=0.01
